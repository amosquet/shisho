DISCORD_TOKEN=your_discord_bot_token_here
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=amosquet/personal-website
OWNER_ID=your_discord_id_here

# Extension-specific whitelists (optional)
# Format: WHITELIST_<COG_NAME>=id1,id2
WHITELIST_READINGLIST=1234567890
WHITELIST_SUGGESTEDBOOKS=9876543210
WHITELIST_PERMISSIONS=1234567890
WHITELIST_NOTIFICATIONS=
WHITELIST_NOTES=
WHITELIST_AICHAT=
WHITELIST_PRINT=

# Toggle access control for specific plugins
# Set to 'false' to disable the whitelist and make the plugin public.
# Set to 'true' (default) to require owner/whitelisted access.
WHITELIST_ENABLE_READINGLIST=true
WHITELIST_ENABLE_SUGGESTEDBOOKS=false
WHITELIST_ENABLE_PERMISSIONS=true
WHITELIST_ENABLE_NOTIFICATIONS=false
WHITELIST_ENABLE_PINGPONG=false
WHITELIST_ENABLE_NOTES=true
WHITELIST_ENABLE_AICHAT=false
WHITELIST_ENABLE_PRINT=true
WHITELIST_ENABLE_AUTH=false

SENTRY_DSN=your_sentry_dsn_here

# PocketBase Configuration
POCKETBASE_URL=https://your-pocketbase-instance.com
POCKETBASE_USER=your_admin_email@example.com
POCKETBASE_PASSWORD=your_admin_password

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Google Books API Key
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# Email Gateway & Print Configuration
EMAIL_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_PORT=993
EMAIL_SMTP_PORT=465
EMAIL_USER=shisho-commands@gmail.com
EMAIL_PASS=your_app_password
ALLOWED_EMAILS=your.email@gmail.com,1234567890@vtext.com_here
PRINTER_EMAIL=your_printer_email@gmail.com
 
# Obsidian / Markdown Vault Configuration (Synced via Syncthing / Local filesystem)
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
